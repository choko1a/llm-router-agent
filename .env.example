APP_NAME="LLM Router Agent"
APP_VERSION="0.1.0"
LOG_LEVEL="INFO"
ROUTER_MODE="rules"
ROUTER_CLASSIFIER_MODEL_PATH="models/router_classifier.pkl"
USE_MOCK="true"
LLM_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_CHEAP_MODEL="gpt-4o-mini"
OPENAI_STRONG_MODEL="gpt-4o"
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_ROUTER_MODEL="openai/gpt-4o-mini"
OPENROUTER_CHEAP_MODEL="openai/gpt-4o-mini"
OPENROUTER_STRONG_MODEL="openai/gpt-4o"
OPENROUTER_AGENT_MODEL="openai/gpt-4o-mini"
OPENROUTER_CODE_MODEL="deepseek/deepseek-chat-v3.1"
AGENT_MAX_TOOL_CALLS="3"
MODEL_MAX_RETRIES="2"
AGENT_ENABLED="true"
TAVILY_API_KEY=""
WEB_SEARCH_PROVIDER="tavily"
WEB_SEARCH_MAX_RESULTS="5"
WEB_SEARCH_MOCK="false"
